# 5GLab Booking System - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===================
# Database Configuration
# ===================
POSTGRES_DB=booking
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_secure_password_here

# ===================
# JWT Configuration (optional - has defaults)
# ===================
# JWT_ACCESS_TOKEN_EXPIRY=15m
# JWT_REFRESH_TOKEN_EXPIRY=7d
# JWT_ISSUER=booking-system

# ===================
# Frontend URL (for email links)
# ===================
# FRONTEND_URL=http://localhost:3000

# ===================
# CORS Configuration
# ===================
# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===================
# CSRF Protection
# ===================
# Enable CSRF protection (recommended if using cookie-based auth)
# CSRF_ENABLED=false

# ===================
# Rate Limiting
# ===================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10          # Auth endpoints: requests per minute
# RATE_LIMIT_PUBLIC=60        # Public endpoints: requests per minute
# RATE_LIMIT_AUTHENTICATED=120 # Authenticated users: requests per minute
