# 5GLab Booking System - Production Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===================
# Database Configuration
# ===================
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===================
# Frontend URL (for email links)
# ===================
FRONTEND_URL=https://your-production-domain.com

# ===================
# CORS Configuration (REQUIRED for production)
# ===================
# Set to your actual frontend domain(s), comma-separated
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# ===================
# CSRF Protection
# ===================
# Enable if using cookie-based authentication
CSRF_ENABLED=false

# ===================
# Rate Limiting (recommended for production)
# ===================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=5             # Stricter for auth endpoints
RATE_LIMIT_PUBLIC=30          # Moderate for public endpoints
RATE_LIMIT_AUTHENTICATED=100  # Generous for authenticated users
